# Copy this file to .env and fill in real values. Never commit .env itself.

DATABASE_URL="postgresql://user:password@localhost:5432/youtube_clone"

JWT_SECRET="replace-with-a-long-random-string"

R2_URL="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS="your-r2-secret-access-key"
R2_PUBLIC_URL="https://<your-r2-public-bucket-url>"
R2_BUCKET_NAME="youtube-clone"

FRONTEND_URL="http://localhost:5173"

PORT=3000
NODE_ENV=development
